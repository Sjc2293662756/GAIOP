  "specialExecutionRules": {
    "overview": {
      "entryCondition": "整体/概览/总览/分析类问题或 queryModeKey=overview",
      "notes": [
        "对象明确时直接 focused overview",
        "对象不明确但要求找出最突出对象后再分析时，使用 analysisPipeline.discoveryQuery"
      ]
    },
    "discoverThenOverview": {
      "outerService": "overview",
      "discoveryPreferredService": "topValues",
      "selectionSignals": [
        "谁",
        "哪个",
        "最多",
        "最高",
        "最慢",
        "最差"
      ],
