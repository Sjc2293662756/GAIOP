  "clarificationRules": [
    {
      "id": "missing_metric",
      "description": "已知对象但缺少指标且无法安全默认时，要求澄清。"
    },
    {
      "id": "missing_time_range",
      "description": "缺少时间范围且不能稳定默认时，要求澄清。"
    },
    {
      "id": "ambiguous_object_scope",
      "description": "业务 / 业务组 / 应用 / WebApplication 范围不清晰时，要求澄清。"
    },
    {
      "id": "multiple_material_queries",
      "description": "多个合理 query 会导致明显不同答案时，要求澄清。"
    }
