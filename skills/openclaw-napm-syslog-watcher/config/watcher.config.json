{
  "syslog": {
    "path": "/var/log/netinside/syslog.log",
    "encoding": "utf-8"
  },
  "napm": {
    "baseUrl": "<NAPM_BASE_URL>",
    "username": "<NAPM_USERNAME>",
    "password": "<NAPM_PASSWORD>",
    "tlsInsecure": true,
    "requestTimeoutMs": 15000
  },
  "wecom": {
    "_comment": "企业微信群机器人 Webhook URL",
    "webhookUrl": "<WECOM_WEBHOOK_URL>",
    "secret": "",
    "mentionedList": [],
    "mentionedMobileList": [],
    "_routing_comment": "可选：按严重级别路由到不同的群。格式: { '紧急': { 'webhookUrl': '...', 'mentionedMobileList': ['138...'] } }",
    "routing": {}
  },
  "alertReference": {
    "enabled": true,
    "ttlHours": 168,
    "packetBufferSeconds": 120
  },
  "dedup": {
    "_comment": "同一 alertId 在 windowSeconds 秒内不重复推送",
    "windowSeconds": 0,
    "maxCacheSize": 500
  },
  "watcher": {
    "_comment": "maxRetries: API 调用最大重试次数; retryDelayMs: 重试间隔毫秒",
    "maxRetries": 3,
    "retryDelayMs": 5000
  }
}
