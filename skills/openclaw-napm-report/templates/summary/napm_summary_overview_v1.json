      "targetModes": ["withTarget"]
    },
    {
      "id": "app_target_slow_clients_table",
      "type": "table",
      "rowBuilder": "appTargetSlowClients",
      "scopes": ["application"],
      "targetModes": ["withTarget"],
      "columns": ["序号", "客户端IP", "连接时间(ms)", "响应时间(ms)", "传输时间(ms)", "重传时延(ms)"]
    },
    {
      "id": "app_target_ext_traffic_heading",
      "type": "heading",
      "title": "流量最大外部地址",
      "level": 2,
      "scopes": ["application"],
      "targetModes": ["withTarget"]
    },
    {
      "id": "app_target_ext_traffic_table",
      "type": "table",
      "rowBuilder": "appTargetExternalTraffic",
      "scopes": ["application"],
      "targetModes": ["withTarget"],
