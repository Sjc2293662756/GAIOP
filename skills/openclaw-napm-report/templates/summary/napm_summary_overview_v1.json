      "scopes": ["application"],
      "targetModes": ["withTarget"]
    },
    {
      "id": "app_target_overview_table",
      "type": "table",
      "rowBuilder": "appTargetOverview",
      "scopes": ["application"],
      "targetModes": ["withTarget"],
      "columns": ["指标", "值"]
    },
    {
      "id": "app_target_userexp_chart",
      "type": "chartSlot",
      "title": "用户体验趋势",
      "chartId": "app.userExpTrend",
      "scopes": ["application"],
      "targetModes": ["withTarget"]
    },
    {
      "id": "app_target_traffic_heading",
      "type": "heading",
      "title": "网络流量趋势",
      "level": 2,
      "scopes": ["application"],
      "targetModes": ["withTarget"]
    },
