    },

    {
      "id": "traffic_heading",
      "type": "heading",
      "title": "3 流量总览",
      "level": 1,
      "scopes": ["global", "network", "application", "businessGroup"],
      "targetModes": ["withoutTarget"]
    },
    {
      "id": "traffic_requirement",
      "type": "paragraphs",
      "scopes": ["global", "network", "application", "businessGroup"],
      "paragraphs": [
        "以下数据展示报告周期内的流量与性能指标排行。"
      ]
    },
    {
      "id": "traffic_trend_heading",
      "type": "heading",
      "title": "流量趋势",
      "level": 2,
      "scopes": ["global", "network", "businessGroup"]
    },
    {
      "id": "traffic_trend_chart",
      "type": "chartSlot",
      "title": "流量趋势图",
      "chartId": "traffic.trend",
      "scopes": ["global", "network", "businessGroup"]
    },
    {
      "id": "traffic_quality_heading",
