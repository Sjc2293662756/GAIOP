{
  "schema": "openclaw_napm_fault_diagnosis_template.v1",
  "templateId": "napm_fault_diagnosis_v1",
  "version": "1.0.0",
  "titlePath": "title",
  "description": "NAPM 故障分析报告固定模板。覆盖故障概述、告警关联分析、流量异常分析、业务性能影响、数据包深度分析和根因建议六大模块。",
  "page": {
    "margin": {
      "top": 1000,
      "right": 900,
      "bottom": 1000,
      "left": 900,
      "header": 450,
      "footer": 450
    },
    "header": {
      "leftImage": {
        "path": "templates/inspection/company-logo.png",
        "width": 110,
        "height": 32,
        "alt": "网深科技流量分析系统"
      },
      "left": "网深科技流量分析系统",
      "right": "{{faultName}}故障分析报告"
    },
    "footer": {
      "center": "第 {{pageNumber}} 页 / 共 {{totalPages}} 页",
      "right": "{{generatedAt}}"
    }
  },
  "sections": [
    {
      "id": "cover",
      "type": "cover",
      "title": "网深科技流量分析系统",
      "subtitle": "故障分析报告"
    },
    {
      "id": "cover_fault_name",
      "type": "paragraphs",
      "alignment": "center",
      "size": 22,
      "paragraphs": [
        "{{faultName}}"
      ]
    },
    {
      "id": "cover_date",
      "type": "paragraphs",
      "alignment": "center",
      "size": 20,
      "paragraphs": [
        "{{timeRange.displayText}}"
      ]
    },
    {
      "id": "cover_break",
      "type": "pageBreak"
    },
    {
      "id": "toc",
      "type": "toc",
      "title": "目录",
      "alias": "Fault Diagnosis Report TOC",
      "headingStyleRange": "1-2",
      "hyperlink": true,
      "updateMode": "wordField"
    },
    {
      "id": "toc_break",
      "type": "pageBreak"
    },

    {
      "id": "overview_heading",
      "type": "heading",
      "title": "1 故障概述",
      "level": 1
    },
    {
      "id": "fault_basic_info_heading",
      "type": "heading",
      "title": "1.1 故障基本信息",
      "level": 2
    },
    {
      "id": "fault_basic_info",
      "type": "table",
      "rowBuilder": "faultBasicInfo",
      "columns": [
        "项目",
        "内容"
      ]
    },
    {
      "id": "fault_timeline_heading",
      "type": "heading",
      "title": "1.2 故障时间线",
      "level": 2,
      "condition": "fault.timeline exists"
    },
    {
      "id": "fault_timeline_table",
      "type": "table",
      "rowBuilder": "faultTimeline",
      "columns": [
        "时间",
        "事件",
        "类型"
      ],
      "condition": "fault.timeline exists"
    },
    {
      "id": "fault_health_heading",
      "type": "heading",
      "title": "1.3 综合影响评估",
      "level": 2
    },
    {
      "id": "fault_health_table",
      "type": "table",
      "rowBuilder": "healthSummary",
      "columns": [
        "评估维度",
        "状态",
        "说明"
      ]
    },
    {
      "id": "fault_overview_narrative",
      "type": "narrative",
      "ruleGroup": "fault.overview",
      "mode": "first"
    },

    {
      "id": "alert_heading",
      "type": "heading",
      "title": "2 告警关联分析",
      "level": 1
    },
    {
      "id": "alert_requirement",
      "type": "paragraphs",
      "paragraphs": [
        "以下数据统计故障时间窗内产生的告警记录，用于分析告警与故障事件的关联关系。"
      ]
    },
    {
      "id": "alert_summary_heading",
      "type": "heading",
      "title": "2.1 告警概览",
      "level": 2
    },
    {
      "id": "alert_summary_table",
      "type": "table",
      "rowBuilder": "alertCategoryStats",
      "columns": [
        "告警类别",
        "总数",
        "紧急",
        "重大",
        "轻微"
      ]
    },
    {
      "id": "alert_timeline_heading",
      "type": "heading",
      "title": "2.2 告警时序",
      "level": 2
    },
    {
      "id": "alert_timeline_chart",
      "type": "chartSlot",
      "title": "告警时序图",
      "chartId": "alert.timeline"
    },
    {
      "id": "alert_details_heading",
      "type": "heading",
      "title": "2.3 关联告警详情",
      "level": 2
    },
    {
      "id": "alert_details_table",
      "type": "table",
      "rowBuilder": "alertDetails",
      "columns": [
        "告警ID",
        "告警名称",
        "级别",
        "类别",
        "对象",
        "开始时间"
      ]
    },
    {
      "id": "alert_narrative",
      "type": "narrative",
      "ruleGroup": "alert.conclusion",
      "mode": "first"
    },

    {
      "id": "traffic_heading",
      "type": "heading",
      "title": "3 流量异常分析",
      "level": 1
    },
    {
      "id": "traffic_requirement",
      "type": "paragraphs",
      "paragraphs": [
        "以下数据展示故障时间窗内的流量趋势，并与正常基线进行对比，定位流量异常的时间和幅度。"
      ]
    },
    {
      "id": "traffic_trend_heading",
      "type": "heading",
      "title": "3.1 流量趋势",
      "level": 2
    },
    {
      "id": "traffic_trend_chart",
      "type": "chartSlot",
      "title": "故障时段流量趋势图",
      "chartId": "traffic.trend"
    },
    {
      "id": "traffic_anomalies_heading",
      "type": "heading",
      "title": "3.2 流量异常明细",
      "level": 2,
      "condition": "trafficAnalysis.anomalies exists"
    },
    {
      "id": "traffic_anomalies_table",
      "type": "table",
      "rowBuilder": "trafficAnomalies",
      "columns": [
        "时间",
        "指标",
        "异常描述",
        "严重级别"
      ],
      "condition": "trafficAnalysis.anomalies exists"
    },
    {
      "id": "traffic_top_heading",
      "type": "heading",
      "title": "3.3 Top 受影响对象",
      "level": 2,
      "condition": "trafficAnalysis.topIPs exists"
    },
    {
      "id": "traffic_top_ip_chart",
      "type": "chartSlot",
      "title": "Top 受影响 IP",
      "chartId": "traffic.topIPs",
      "condition": "trafficAnalysis.topIPs exists"
    },
    {
      "id": "traffic_top_ip_table",
      "type": "table",
      "rowBuilder": "trafficTopIPs",
      "columns": [
        "序号",
        "IP地址",
        "总流量(kb/s)",
        "入流量(kb/s)",
        "出流量(kb/s)"
      ],
      "condition": "trafficAnalysis.topIPs exists"
    },
    {
      "id": "traffic_narrative",
      "type": "narrative",
      "ruleGroup": "traffic.conclusion",
      "mode": "first"
    },

    {
      "id": "business_heading",
      "type": "heading",
      "title": "4 业务性能影响",
      "level": 1
    },
    {
      "id": "business_requirement",
      "type": "paragraphs",
      "paragraphs": [
        "以下数据展示故障时间窗内业务性能状况，重点关注慢访问和 HTTP 错误的变化。"
      ]
    },
    {
      "id": "business_slow_heading",
      "type": "heading",
      "title": "4.1 慢访问状况",
      "level": 2
    },
    {
      "id": "business_slow_chart",
      "type": "chartSlot",
      "title": "慢访问业务",
      "chartId": "business.slowAccess"
    },
    {
      "id": "business_slow_table",
      "type": "table",
      "rowBuilder": "businessSlowTable",
      "columns": [
        "序号",
        "业务名称",
        "慢访问占比",
        "慢访问次数",
        "平均时延(ms)"
      ]
    },
    {
      "id": "business_error_heading",
      "type": "heading",
      "title": "4.2 HTTP 错误状况",
      "level": 2
    },
    {
      "id": "business_error_chart",
      "type": "chartSlot",
      "title": "HTTP 错误业务",
      "chartId": "business.httpErrors"
    },
    {
      "id": "business_error_table",
      "type": "table",
      "rowBuilder": "businessErrorTable",
      "columns": [
        "序号",
        "业务名称",
        "HTTP 400",
        "HTTP 500"
      ]
    },
    {
      "id": "business_narrative",
      "type": "narrative",
      "ruleGroup": "business.conclusion",
      "mode": "first"
    },

    {
      "id": "packet_heading",
      "type": "heading",
      "title": "5 数据包深度分析",
      "level": 1,
      "condition": "packetAnalysis exists"
    },
    {
      "id": "packet_requirement",
      "type": "paragraphs",
      "paragraphs": [
        "以下数据来源于故障时段抓包文件的深度分析，用于辅助根因定位。"
      ],
      "condition": "packetAnalysis exists"
    },
    {
      "id": "packet_protocol_heading",
      "type": "heading",
      "title": "5.1 协议分布",
      "level": 2,
      "condition": "packetAnalysis exists"
    },
    {
      "id": "packet_protocol_table",
      "type": "table",
      "rowBuilder": "packetProtocol",
      "columns": [
        "序号",
        "协议",
        "帧数",
        "字节数"
      ],
      "condition": "packetAnalysis.protocolHierarchy exists"
    },
    {
      "id": "packet_endpoints_heading",
      "type": "heading",
      "title": "5.2 关键端点与会话",
      "level": 2,
      "condition": "packetAnalysis exists"
    },
    {
      "id": "packet_endpoints_table",
      "type": "table",
      "rowBuilder": "packetEndpoints",
      "caption": "Top 对端",
      "columns": [
        "序号",
        "地址",
        "数据包数",
        "字节数"
      ],
      "condition": "packetAnalysis.endpoints exists"
    },
    {
      "id": "packet_conversations_table",
      "type": "table",
      "rowBuilder": "packetConversations",
      "caption": "Top 会话",
      "columns": [
        "序号",
        "源地址",
        "目标地址",
        "数据包数",
        "字节数"
      ],
      "condition": "packetAnalysis.conversations exists"
    },
    {
      "id": "packet_highlights_heading",
      "type": "heading",
      "title": "5.3 关键发现",
      "level": 2,
      "condition": "packetAnalysis.highlights exists"
    },
    {
      "id": "packet_highlights",
      "type": "dataParagraphs",
      "label": "数据包分析关键发现：",
      "dataPath": "packetAnalysis.highlights",
      "emptyText": "无特别发现。",
      "condition": "packetAnalysis.highlights exists"
    },
    {
      "id": "packet_narrative",
      "type": "narrative",
      "ruleGroup": "packet.conclusion",
      "mode": "first"
    },

    {
      "id": "conclusion_heading",
      "type": "heading",
      "title": "6 根因分析与建议",
      "level": 1
    },
    {
      "id": "root_cause_heading",
      "type": "heading",
      "title": "6.1 根因判断",
      "level": 2
    },
    {
      "id": "root_cause_narrative",
      "type": "narrative",
      "ruleGroup": "root_cause",
      "mode": "first"
    },
    {
      "id": "recommendations_heading",
      "type": "heading",
      "title": "6.2 修复建议",
      "level": 2
    },
    {
      "id": "recommendations",
      "type": "dataParagraphs",
      "dataPath": "fault.recommendations",
      "emptyText": "建议结合以上各维度数据进一步分析，必要时进行抓包复现。"
    },
    {
      "id": "prevention_heading",
      "type": "heading",
      "title": "6.3 预防措施",
      "level": 2
    },
    {
      "id": "prevention",
      "type": "dataParagraphs",
      "dataPath": "fault.prevention",
      "emptyText": "建议根据根因结论制定相应的监控告警策略和应急预案。"
    }
  ]
}
