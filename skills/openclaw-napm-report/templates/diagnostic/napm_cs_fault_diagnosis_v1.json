{
  "schema": "openclaw_napm_cs_fault_template.v1",
  "templateId": "napm_cs_fault_diagnosis_v1",
  "version": "1.0.0",
  "titlePath": "title",
  "description": "NAPM C/S 应用故障分析报告固定模板。按公司 §8 结构：基本信息→分析过程→证据→根因→建议→验证。3 步固定流程：应用概览→用户体验趋势→波峰窗口客户端分析。",
  "page": {
    "margin": { "top": 1000, "right": 900, "bottom": 1000, "left": 900, "header": 450, "footer": 450 },
    "header": {
      "leftImage": { "path": "templates/inspection/company-logo.png", "width": 110, "height": 32, "alt": "网深科技基于AI的全流量性能分析平台" },
      "left": "网深科技基于AI的全流量性能分析平台",
      "right": "{{diagnosis.targetLabel}}应用故障分析报告"
    },
    "footer": {
      "center": "第 {{pageNumber}} 页 / 共 {{totalPages}} 页",
      "right": "{{diagnosis.reportDate}}"
    }
  },
  "sections": [
    { "id": "cover", "type": "cover", "title": "网深科技基于AI的全流量性能分析平台", "subtitle": "应用故障分析报告" },
    { "id": "cover_info", "type": "paragraphs", "alignment": "center", "size": 22, "paragraphs": ["{{title}}"] },
    { "id": "cover_date", "type": "paragraphs", "alignment": "center", "size": 20, "paragraphs": ["{{diagnosis.reportDate}}"] },
    { "id": "cover_break", "type": "pageBreak" },
    { "id": "toc", "type": "toc", "title": "目录", "alias": "CS Fault Report TOC", "headingStyleRange": "1-2", "hyperlink": true, "updateMode": "wordField" },
    { "id": "toc_break", "type": "pageBreak" },

    { "id": "basic_heading", "type": "heading", "title": "1 基本信息", "level": 1 },
    { "id": "basic_info", "type": "staticTable", "columns": ["项目", "内容"], "rows": [
      ["故障名称", "{{diagnosis.description}}"],
      ["分析类型", "{{diagnosis.flowLabel}}"],
      ["分析时间", "{{timeRange.displayText}}"],
      ["分析对象", "{{diagnosis.targetLabel}}（{{diagnosis.targetType}}）"],
      ["故障级别", "{{diagnosis.severityLabel}}"],
      ["执行步骤数", "{{diagnosis.stepCount}}"]
    ]},

    { "id": "process_heading", "type": "heading", "title": "2 分析过程", "level": 1 },
    { "id": "process_intro", "type": "paragraphs", "paragraphs": [
      "本次分析按照【应用整体概览 → 用户体验时间趋势 → 波峰时刻客户端下钻】的思路展开，先评估 C/S 应用的流量和性能基线，再通过用户体验时间序列查找波峰时刻，最后在波峰窗口内定位具体客户端来源，逐步形成可复核的故障证据链。"
    ]},

    { "id": "step1_heading", "type": "heading", "title": "2.1 应用运行状况概览", "level": 2 },
    { "id": "step1_desc", "type": "paragraphs", "paragraphs": [
      "分析先从 C/S 应用的整体性能概要入手。通过用户体感指数（UEII）、建连时间（CSTI）、服务器响应时间（TRTI）、有效载荷传输时间（PTTO）和重传时延（RDTO）五个维度评估应用健康度。UEII 是综合体验评分；CSTI 高可能指向网络路径或策略设备问题；TRTI 高倾向于服务端处理瓶颈；PTTO 高可能源于带宽不足；RDTO 高则指向链路丢包或网络质量问题。"
    ]},
    { "id": "step1_query_info", "type": "paragraphs", "paragraphs": ["查询时间范围：{{timeRange.displayText}}"] },
    { "id": "step1_overview_table", "type": "table", "rowBuilder": "csOverview", "columns": ["指标", "数值"] },
    { "id": "step1_hint", "type": "dataParagraphs", "label": "分析提示：", "dataPath": "diagnosis.step1Hints", "emptyText": "本次查询未发现显著异常。" },

    { "id": "step2_heading", "type": "heading", "title": "2.2 用户体验趋势分析", "level": 2 },
    { "id": "step2_desc", "type": "paragraphs", "paragraphs": [
      "在掌握整体性能基线后，第二步通过用户体验指标（UEII/CSTI/TRTI/PTTO/RDTO）的时间序列数据查找波峰时刻。波峰代表用户体验出现集中劣化的时间点，是定位故障时段的关键锚点。对于离散尖峰取前 5 个最高值进行分析，对于持续高原型异常则取开始、1/4、1/2、3/4、结束五个采样点覆盖整个异常区间。"
    ]},
    { "id": "step2_hint", "type": "dataParagraphs", "label": "分析提示：", "dataPath": "diagnosis.step2Hints", "emptyText": "用户体验时间序列数据未返回有效结果或未检测到显著波峰。" },

    { "id": "step3_heading", "type": "heading", "title": "2.3 波峰窗口客户端分析", "level": 2 },
    { "id": "step3_desc", "type": "paragraphs", "paragraphs": [
      "在确定了用户体验波峰时刻后，第三步在每个波峰时刻前后各 30 秒的时间窗口内下钻到具体客户端 IP。通过分析波峰时刻的客户端分布，可以判断慢体验是集中在少数客户端（可能是客户端自身问题或接入链路问题），还是分散在大量客户端（更可能是服务端或网络侧问题）。每个客户端展示其用户体感指数（UEII）、建连时间（CSTI）、服务器响应时间（TRTI）、有效载荷传输时间（PTTO）和重传时延（RDTO）。"
    ]},
    { "id": "step3_peak_table", "type": "table", "rowBuilder": "csPeakSummary", "columns": ["波峰", "客户端数", "最慢客户端", "体验时间(ms)"] },
    { "id": "step3_detail_table", "type": "table", "rowBuilder": "csSlowClients", "columns": ["波峰时段", "客户端IP", "体验时间(ms)", "建连时间(ms)", "响应时间(ms)", "传输时间(ms)", "重传时间(ms)"] },
    { "id": "step3_hint", "type": "dataParagraphs", "label": "分析提示：", "dataPath": "diagnosis.step3Hints", "emptyText": "波峰客户端分析未检测到显著波峰或数据不足。" },

    { "id": "evidence_heading", "type": "heading", "title": "3 证据项", "level": 1 },
    { "id": "evidence_intro", "type": "paragraphs", "paragraphs": [
      "本节汇总本次分析过程中使用的主要数据来源和下钻结果，便于对分析路径进行复核。证据项从应用性能基线、用户体验时间序列到波峰窗口客户端分析逐层展开，能够支撑后续根因判断和处置建议。"
    ]},
    { "id": "evidence_table", "type": "table", "rowBuilder": "csEvidence", "columns": ["步骤", "查询指标", "数据量"] },

    { "id": "rootcause_heading", "type": "heading", "title": "4 根因判断", "level": 1 },
    { "id": "rootcause_narrative", "type": "narrative", "ruleGroup": "cs.root_cause", "mode": "first" },

    { "id": "recommend_heading", "type": "heading", "title": "5 处置建议", "level": 1 },
    { "id": "recommend_list", "type": "dataParagraphs", "dataPath": "diagnosis.recommendations", "emptyText": "建议优先核查用户体验瓶颈成分和波峰时刻客户端分布：若建连时间占比高，排查网络路径、防火墙策略和负载均衡；若服务器响应时间占比高，排查应用日志、数据库和中间件状态；若集中在少数客户端，核查客户端环境和接入链路；若重传时间高，转入网络质量专项分析。" },

    { "id": "verify_heading", "type": "heading", "title": "6 验证方式", "level": 1 },
    { "id": "verify_list", "type": "dataParagraphs", "dataPath": "diagnosis.prevention", "emptyText": "处置完成后，可在相同应用维度和相近时间窗口重新观察用户体感指数变化、各时间成分占比分布和波峰时刻客户端分布变化。若 UEII 下降、瓶颈成分消失且波峰客户端分布恢复均匀，可作为问题收敛或修复有效的验证依据。" }
  ]
}
