{
  "schema": "openclaw_napm_inspection_template.v1",
  "templateId": "napm_traffic_health_inspection_v1",
  "version": "1.0.0",
  "titlePath": "title",
  "description": "NAPM 流量分析系统巡检报告固定模板。章节、表格、图表槽位和叙述槽位固定，运行时只更新数据、图表数据绑定和规则叙述。",
  "sections": [
    {
      "id": "cover",
      "type": "cover",
      "title": "{{title}}",
      "subtitle": "流量分析系统巡检报告"
    },
    {
      "id": "basic_info",
      "type": "keyValueTable",
      "title": "报告基础信息",
      "columns": ["项目", "内容"],
      "rows": [
        { "label": "客户名称", "valuePath": "inspection.customerName" },
        { "label": "项目名称", "valuePath": "inspection.projectName" },
        { "label": "巡检日期", "valuePath": "inspection.reportDate" },
        { "label": "报告类型", "valuePath": "reportType" },
        { "label": "模板编号", "valuePath": "templateId" },
        { "label": "数据来源", "valuePath": "dataSource.sourceSkill" },
        { "label": "总体状态", "valuePath": "inspection.summary.overallStatus", "transform": "status" }
      ]
    },
    {
      "id": "inspection_result_heading",
      "type": "heading",
      "title": "六、巡检结果",
      "level": 1
    },
    {
      "id": "devices",
      "type": "table",
      "title": "6.1 设备基本信息",
      "caption": "设备清单",
      "rowBuilder": "devices",
      "columns": ["序号", "系统名称", "IP地址", "软件版本", "序列号", "设备时间", "运行时长"]
    },
    {
      "id": "performance_items",
      "type": "table",
      "title": "6.2 性能状况",
      "caption": "性能检查项",
      "rowBuilder": "sectionItems",
      "dataPath": "inspection.performance",
      "columns": ["序号", "检查项", "检查值", "备注"]
    },
    {
      "id": "performance_findings",
      "type": "table",
      "caption": "性能结论",
      "rowBuilder": "findings",
      "dataPath": "inspection.performance.findings",
      "columns": ["序号", "级别", "结论", "证据"]
    },
    {
      "id": "data_retention",
      "type": "table",
      "title": "6.3 数据信息",
      "caption": "数据保留检查项",
      "rowBuilder": "sectionItems",
      "dataPath": "inspection.dataRetention",
      "columns": ["序号", "检查项", "检查值", "备注"]
    },
    {
      "id": "configuration",
      "type": "table",
      "title": "6.4 配置信息",
      "caption": "配置检查项",
      "rowBuilder": "sectionItems",
      "dataPath": "inspection.configuration",
      "columns": ["序号", "检查项", "检查值", "备注"]
    },
    {
      "id": "packet_storage",
      "type": "table",
      "title": "6.5 原始数据包存储",
      "caption": "原始数据包存储检查项",
      "rowBuilder": "sectionItems",
      "dataPath": "inspection.packetStorage",
      "columns": ["序号", "检查项", "检查值", "备注"]
    },
    {
      "id": "traffic_narrative",
      "type": "narrative",
      "title": "6.6 流量分析状况",
      "ruleGroup": "traffic.summary",
      "mode": "all"
    },
    {
      "id": "traffic_chart_recent_hour",
      "type": "chartSlot",
      "title": "图 6.6-1 最近1小时总流量趋势图",
      "chartId": "traffic.recentHour.total"
    },
    {
      "id": "traffic_chart_recent_day",
      "type": "chartSlot",
      "title": "图 6.6-2 最近1天总流量趋势图",
      "chartId": "traffic.recentDay.total"
    },
    {
      "id": "traffic_stats",
      "type": "table",
      "caption": "流量趋势统计",
      "rowBuilder": "trafficStats",
      "columns": ["窗口", "名称", "数据点", "最大值", "最小值", "平均值", "缺失点", "零流量点", "尖峰点"]
    },
    {
      "id": "traffic_recent_hour_samples",
      "type": "table",
      "caption": "最近1小时趋势样本",
      "rowBuilder": "trafficSamples",
      "dataPath": "inspection.trafficAnalysis.recentHour",
      "maxRows": 12
    },
    {
      "id": "traffic_recent_day_samples",
      "type": "table",
      "caption": "最近1天趋势样本",
      "rowBuilder": "trafficSamples",
      "dataPath": "inspection.trafficAnalysis.recentDay",
      "maxRows": 12
    },
    {
      "id": "traffic_findings",
      "type": "table",
      "caption": "流量分析结论",
      "rowBuilder": "findings",
      "dataPath": "inspection.trafficAnalysis.findings",
      "columns": ["序号", "级别", "结论", "证据"]
    },
    {
      "id": "business_narrative",
      "type": "narrative",
      "title": "6.7 业务性能状况",
      "ruleGroup": "business.summary",
      "mode": "all"
    },
    {
      "id": "business_slow_chart",
      "type": "chartSlot",
      "title": "图 6.7-1 慢访问业务 Top 图",
      "chartId": "business.slowAccess.top"
    },
    {
      "id": "business_error_chart",
      "type": "chartSlot",
      "title": "图 6.7-2 HTTP 400/500 业务 Top 图",
      "chartId": "business.httpErrors.top"
    },
    {
      "id": "business_slow",
      "type": "table",
      "caption": "慢访问业务",
      "rowBuilder": "businessSlow",
      "columns": ["序号", "业务", "慢访问占比", "慢访问次数", "平均页面时延(ms)", "证据"]
    },
    {
      "id": "business_errors",
      "type": "table",
      "caption": "HTTP 400/500 业务",
      "rowBuilder": "businessErrors",
      "columns": ["序号", "业务", "HTTP 400", "HTTP 500", "证据"]
    },
    {
      "id": "business_findings",
      "type": "table",
      "caption": "业务性能结论",
      "rowBuilder": "findings",
      "dataPath": "inspection.businessPerformance.findings",
      "columns": ["序号", "级别", "结论", "证据"]
    },
    {
      "id": "summary_heading",
      "type": "heading",
      "title": "七、巡检总结",
      "level": 1
    },
    {
      "id": "summary_narrative",
      "type": "narrative",
      "ruleGroup": "summary.conclusion",
      "mode": "first"
    },
    {
      "id": "summary_devices",
      "type": "table",
      "caption": "设备健康汇总",
      "rowBuilder": "summaryDevices",
      "columns": ["序号", "设备", "CPU使用", "磁盘使用", "丢包数", "健康状态", "备注"]
    },
    {
      "id": "summary_abnormal_items",
      "type": "table",
      "caption": "需关注事项",
      "rowBuilder": "abnormalItems",
      "columns": ["序号", "事项"]
    },
    {
      "id": "query_evidence",
      "type": "table",
      "title": "附录：查询证据",
      "caption": "查询证据",
      "rowBuilder": "evidence",
      "columns": ["序号", "ID", "服务", "分组", "指标", "排序/粒度", "时间范围", "请求URL(已打码)"]
    }
  ]
}
