# NetInside / NAPM WebService endpoint.
# Example: https://192.0.2.10/webservice/NetInside
NETINSIDE_HOST=
NETINSIDE_USERNAME=
NETINSIDE_PASSWORD=

# Set true only for local deployments that use self-signed certificates.
NETINSIDE_TLS_INSECURE=false

# Skill-local metadata and hierarchy defaults.
NAPM_GROUPS_TREE_MODE=static
NAPM_STATIC_GROUPS_TREE_FILE=./config/groups-tree.static.json
NAPM_RESOLUTION_BOUNDARY_MODE=strict

# Runtime output and logging.
LOG_LEVEL=info
SHOW_UPSTREAM_API_IN_REPLY=false
SKILL_FORWARD_DISPLAY_TEXT=false

# Legacy prompt-template fallback remains off in standalone skill mode.
DISABLE_GATEWAY_TEMPLATES=false
