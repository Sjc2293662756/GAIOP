# Server Configuration
PORT=8083
NODE_ENV=development

# NetInside API Configuration
# Example:
# NETINSIDE_HOST=https://101.254.114.238/webservice/NetInside
NETINSIDE_HOST=
NETINSIDE_USERNAME=
NETINSIDE_PASSWORD=
# true: allow self-signed / invalid HTTPS certificate
NETINSIDE_TLS_INSECURE=false
# Groups tree source: static (default) | auto | remote
NAPM_GROUPS_TREE_MODE=static
# Optional: custom static groups tree file path
NAPM_STATIC_GROUPS_TREE_FILE=./config/groups-tree.static.json

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log
SHOW_UPSTREAM_API_IN_REPLY=false

# Gateway Template Switch
DISABLE_GATEWAY_TEMPLATES=false

# Skill Runtime Switches
# true: do not call /api/gateway/tools/napm.skill.query (legacy fallback path)
SKILL_DISABLE_GATEWAY_BRIDGE=false
# true: understanding-only, skip real query execution
SKILL_UNDERSTANDING_ONLY=false
# true: enable skill -> gateway bridge execution
SKILL_ENABLE_GATEWAY_SKILL_BRIDGE=true
# true: forward displayText/replyText from skill (false = OpenClaw narrates from narrationInput)
SKILL_FORWARD_DISPLAY_TEXT=false
# Query boundary mode: compat (current fallback behavior) | strict (resolvedQuery required)
NAPM_RESOLUTION_BOUNDARY_MODE=compat

# Cache Configuration
CACHE_TTL=3600


# Gateway query-only mode (recommended)
GATEWAY_QUERY_ONLY_MODE=true
# Force gateway to only accept upstream-executed contract (assistantDecision + resolvedQuerySeed)
GATEWAY_ENFORCE_UPSTREAM_EXECUTION=true
# Ensure query endpoints are not blocked by understanding-only guard
GATEWAY_UNDERSTANDING_ONLY=false
# Allow appending intent trace text (contains mode/confidence) into displayText
GATEWAY_ALLOW_INTENT_TRACE_IN_REPLY=false
# Forward displayText/replyText to upper layer (false = OpenClaw narrates from narrationInput)
GATEWAY_FORWARD_DISPLAY_TEXT=false




